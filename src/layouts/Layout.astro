---
import BaseMeta from "../components/BaseMeta.astro";
import Footer from "../components/Footer.astro";
import Navigation from "../components/Navigation.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import { ClientRouter } from "astro:transitions";
import CookieBanner from "../components/CookieBanner.astro";
import "../styles/global.css";
import Newsletter from "../components/Newsletter.astro";
const { title, showNewsletter = true } = Astro.props;
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <BaseMeta title={title} description="Some description" />
    <ClientRouter />
  </head>
  <body>
    <ScrollToTop />
    <Navigation firstName="Grzegorz" lastName="Kossowski" />
    <article>
      <slot />
    </article>
    {showNewsletter && <Newsletter />}
    <Footer firstName="Grzegorz" lastName="Kossowski" />
    <CookieBanner />
  </body><style>
    h1 {
      font-size: 2rem;
    }
  </style>
</html>
