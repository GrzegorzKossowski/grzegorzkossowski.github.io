<div id="cookie-banner" class="fixed bottom-4 left-4 right-4 md:right-auto md:max-w-md bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 p-6 rounded-2xl shadow-2xl z-100 transform translate-y-20 opacity-0 transition-all duration-500">
  <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
    Ta strona używa plików cookies, aby zapewnić Ci jak najlepsze wrażenia. Szczegóły znajdziesz w 
    <a href="/polityka" class="text-romance-600 underline">Polityce Prywatności</a>.
  </p>
  <button id="accept-cookies" class="w-full bg-romance-600 hover:bg-romance-500 text-white font-bold py-2 px-4 rounded-lg transition-colors">
    Rozumiem
  </button>
</div>

<script>
  const banner = document.getElementById('cookie-banner');
  const btn = document.getElementById('accept-cookies');

  // Sprawdź czy użytkownik już zaakceptował cookies
  if (!localStorage.getItem('cookies-accepted')) {
    setTimeout(() => {
      banner?.classList.remove('translate-y-20', 'opacity-0');
    }, 1000);
  }

  btn?.addEventListener('click', () => {
    localStorage.setItem('cookies-accepted', 'true');
    banner?.classList.add('translate-y-20', 'opacity-0');
  });
</script>