---
// src/components/LatestBooks.astro
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { Sparkles, ChevronRight } from "lucide-astro";
import placeholderCover from "../assets/covers/placeholder-cover.jpg";

const allBooks = await getCollection("books");
const latest = allBooks
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const now = new Date();
const THIRTY_DAYS_MS = 30 * 24 * 60 * 60 * 1000;
---

<section class="py-24 bg-gray-50 dark:bg-slate-900/10" id="latest">
  <div class="container mx-auto px-5 max-w-7xl">
    <div class="mb-12">
      <h2
        class="text-h2 font-serif italic uppercase tracking-tighter text-gray-900 dark:text-white"
      >
        Ostatnie premiery
      </h2>
      <div class="h-1 w-20 bg-romance-600 dark:bg-gold-500 rounded"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6">
      {/* Pętla renderująca 3 pobrane książki */}
      {
        latest.map((book) => {
          const isFuture = book.data.publishDate > now;
          const isRecent =
            now.getTime() - book.data.publishDate.getTime() < THIRTY_DAYS_MS;
          const showBadge = isFuture || isRecent;
          const coverImage = (book.data.cover || placeholderCover) as any;

          return (
            <div class="bg-white dark:bg-slate-900/40 p-5 rounded-2xl border border-gray-100 dark:border-slate-800 h-full flex flex-col group transition-all duration-300 hover:shadow-xl">
              <a
                href={`/ksiazki/${book.slug}`}
                class="relative block mb-6 overflow-hidden rounded-lg aspect-[5/7] bg-slate-100 dark:bg-slate-800"
              >
                <Image
                  src={coverImage}
                  alt={book.data.title}
                  width={400}
                  height={560}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                />
                {showBadge && (
                  <span class="absolute top-3 right-3 text-[9px] font-bold px-2 py-1 rounded bg-romance-600 text-white uppercase tracking-widest z-10 shadow-lg">
                    {isFuture ? "Zapowiedź" : "Nowość"}
                  </span>
                )}
              </a>

              <div class="grow">
                <span class="text-[10px] font-bold text-romance-600 dark:text-gold-500 uppercase tracking-[0.2em]">
                  {book.data.category}
                </span>
                <h3 class="text-xl font-serif font-bold mt-2 mb-3 leading-tight text-gray-900 dark:text-white group-hover:text-romance-600 dark:group-hover:text-gold-500 transition-colors">
                  {book.data.title}
                </h3>
                <p class="text-[11px] opacity-60 italic text-gray-600 dark:text-gray-400">
                  Premiera: {book.data.publishDate.toLocaleDateString("pl-PL")}
                </p>
              </div>

              <a
                href={`/ksiazki/${book.slug}`}
                class="mt-6 text-xs font-bold uppercase tracking-widest link-elegant inline-flex items-center gap-2 group-hover:gap-3 transition-all"
              >
                Szczegóły <ChevronRight size={14} />
              </a>
            </div>
          );
        })
      }

      <div
        class="bg-white dark:bg-slate-900/40 p-5 rounded-2xl border border-gray-100 dark:border-slate-800 h-full flex flex-col group opacity-90 hover:opacity-100 transition-all duration-300 hover:shadow-xl"
      >
        <div
          class="relative block mb-6 overflow-hidden rounded-lg aspect-[5/7] bg-gray-100 dark:bg-slate-800"
        >
          <Image
            src={placeholderCover as any}
            alt="Wkrótce nowa historia"
            width={400}
            height={560}
            class="w-full h-full object-cover grayscale opacity-70 transition-transform duration-700 group-hover:scale-105"
          />
          <div
            class="absolute inset-0 flex items-center justify-center pointer-events-none"
          >
            <Sparkles
              class="text-romance-600/20 dark:text-gold-500/20"
              size={48}
            />
          </div>
        </div>

        <div class="grow">
          <span
            class="text-[10px] font-bold text-gray-400 dark:text-slate-500 uppercase tracking-[0.2em]"
          >
            W przygotowaniu
          </span>
          <h3
            class="text-xl font-serif font-bold mt-2 mb-3 leading-tight text-gray-400 dark:text-slate-500 italic"
          >
            Nowa opowieść...
          </h3>
          <p
            class="text-[11px] opacity-40 italic text-gray-500 dark:text-slate-500 leading-relaxed"
          >
            Kolejna historia powstaje w ciszy gabinetu. Dowiesz się o niej
            pierwszy.
          </p>
        </div>

        <div
          class="mt-6 text-xs font-bold uppercase tracking-widest opacity-20 italic flex items-center gap-2"
        >
          Wkrótce <ChevronRight size={14} />
        </div>
      </div>
    </div>
  </div>
</section>
