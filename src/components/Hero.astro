---
import { ShoppingBag, BookOpen } from "lucide-astro";
interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { description, image = "/images/latest-book-mockup.jpg" } = Astro.props;
---

<section class="relative overflow-hidden" id="hero">
  <div
    class="container mx-auto flex px-5 py-24 md:flex-row flex-col items-center"
  >
    <div
      class="lg:grow md:w-1/2 lg:pr-24 md:pr-16 flex flex-col md:items-start md:text-left mb-16 md:mb-0 items-center text-center"
    >
      <div
        class="mb-3 text-sm tracking-[0.3em] uppercase text-romance-600 dark:text-gold-500 font-bold"
      >
        <slot name="author" />
      </div>

      <h1 class="text-gray-900 dark:text-white">
        <slot name="title" />
      </h1>

      <div class="hero-description mb-10">
        <slot name="description" />
      </div>

      <div class="flex flex-wrap justify-center gap-5">
        <slot name="buttons" />
      </div>
    </div>

    <div class="lg:max-w-lg lg:w-full md:w-1/2 w-5/6">
      <div class="relative group">
        <div
          class="absolute -inset-1 bg-linear-to-r from-romance-600 to-gold-500 rounded-xl blur opacity-20 group-hover:opacity-40 transition duration-1000"
        >
        </div>
        <slot name="image" />
      </div>
    </div>
  </div>
</section>
