---
// src/components/BooksTable.astro
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import placeholderCover from "../assets/covers/placeholder-cover.jpg";
import { AudioLines, FileText, Tablet, Volume2 } from "lucide-astro";

const allBooks = (await getCollection("books")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<div
  class="bg-white dark:bg-slate-900/40 rounded-2xl border border-gray-100 dark:border-slate-800 shadow-sm overflow-hidden"
>
  {/* Nagłówek Gridowy (tylko dla desktopu) */}
  <div
    class="hidden md:grid grid-cols-[100px_minmax(200px,2fr)_1fr_120px_100px_100px] gap-4 px-8 py-5 border-b border-gray-200 dark:border-slate-700 bg-gray-50/50 dark:bg-slate-800/50 text-[11px] uppercase tracking-[0.2em] font-bold opacity-60"
  >
    <div>Okładka</div>
    <div>Tytuł</div>
    <div class="hidden lg:block">Gatunek</div>
    <div class="text-center">Premiera</div>
    <div class="text-center hidden xl:block">Strony</div>
    <div class="text-right">Cena</div>
  </div>

  {/* Lista wierszy */}
  <div class="flex flex-col divide-y divide-gray-100 dark:divide-slate-800">
    {
      allBooks.map((book) => {
        const coverImage = (book.data.cover || placeholderCover) as any;

        return (
          <a
            href={`/ksiazki/${book.slug}`}
            class="group block hover:bg-gray-50 dark:hover:bg-slate-800/60 transition-all duration-300 cursor-pointer"
          >
            <div class="grid grid-cols-[80px_1fr_auto] md:grid-cols-[100px_minmax(200px,2fr)_1fr_120px_100px_100px] gap-4 px-6 md:px-8 py-6 items-center">
              {/* 1. Okładka */}
              <div class="flex justify-start">
                <div class="w-14 h-20 md:w-16 md:h-22 overflow-hidden rounded-lg shadow-md bg-slate-100 dark:bg-slate-800 border border-gray-100 dark:border-slate-700">
                  <Image
                    src={coverImage}
                    alt={book.data.title}
                    width={120}
                    height={160}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                  />
                </div>
              </div>

              {/* 2. Tytuł i Gatunek (mobile) */}
              <div class="flex flex-row space-x-2 items-center">
                <h3 class="font-bold font-serif text-base md:text-lg text-gray-900 dark:text-white leading-tight group-hover:text-romance-600 dark:group-hover:text-gold-500 transition-colors line-clamp-2">
                  {book.data.title}
                </h3>
                  <span class="text-xs text-gold-500 uppercase tracking-widest mt-1">
                    <FileText size={14} />
                  </span>
                {book.data.audiobook && (
                  <span class="text-xs text-gold-500 uppercase tracking-widest mt-1">
                    <Volume2 size={14} />
                  </span>
                )}
                <span class="md:hidden text-[10px] font-bold text-romance-600 dark:text-gold-500 mt-1 uppercase tracking-widest">
                  {book.data.category}
                </span>
              </div>

              {/* 3. Gatunek (Desktop) */}
              <div class="hidden lg:block text-base italic text-gray-600 dark:text-gray-400">
                {book.data.category}
              </div>

              {/* 4. Premiera */}
              <div class="hidden md:block text-base text-center font-medium opacity-70">
                {book.data.publishDate.toLocaleDateString("pl-PL")}
              </div>

              {/* 5. Strony */}
              <div class="hidden xl:block text-sm opacity-50 text-center font-mono">
                {book.data.pages}
              </div>

              {/* 6. Cena */}
              <div class="text-right">
                <span class="font-bold text-base text-romance-700 dark:text-gold-500 whitespace-nowrap">
                  {book.data.price ? `${book.data.price} zł` : "—"}
                </span>
              </div>
            </div>
          </a>
        );
      })
    }
  </div>
</div>
