---
// src/components/BooksTable.astro
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import placeholderCover from "../assets/covers/placeholder-cover.jpg";

const allBooks = (await getCollection("books")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<section class="py-12">
  <div
    class="overflow-x-auto bg-white dark:bg-slate-900/40 rounded-2xl border border-gray-100 dark:border-slate-800 shadow-sm"
  >
    <table class="w-full text-left border-collapse">
      <thead>
        <tr
          class="border-b border-gray-200 dark:border-slate-700 bg-gray-50/50 dark:bg-slate-800/50"
        >
          <th
            class="py-5 px-6 text-[11px] uppercase tracking-[0.2em] font-bold opacity-60"
            >Okładka</th
          >
          <th
            class="py-5 px-6 text-[11px] uppercase tracking-[0.2em] font-bold opacity-60"
            >Tytuł</th
          >
          <th
            class="py-5 px-6 text-[11px] uppercase tracking-[0.2em] font-bold opacity-60 hidden md:table-cell"
            >Gatunek</th
          >
          <th
            class="py-5 px-6 text-[11px] uppercase tracking-[0.2em] font-bold opacity-60 hidden lg:table-cell text-center"
            >Premiera</th
          >
          <th
            class="py-5 px-6 text-[11px] uppercase tracking-[0.2em] font-bold opacity-60 hidden xl:table-cell text-center"
            >Strony</th
          >
          <th
            class="py-5 px-6 text-[11px] uppercase tracking-[0.2em] font-bold opacity-60 hidden sm:table-cell"
            >Cena</th
          >
          <th class="py-5 px-6"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 dark:divide-slate-800">
        {
          allBooks.map((book) => {
            const coverImage = (book.data.cover || placeholderCover) as any;

            return (
              <tr class="hover:bg-romance-50/30 dark:hover:bg-slate-800/40 transition-colors group">
                <td class="py-6 px-6 w-24">
                  <div class="w-16 h-22 overflow-hidden rounded-lg shadow-md bg-slate-100 dark:bg-slate-800 border border-gray-100 dark:border-slate-700">
                    <Image
                      src={coverImage}
                      alt={book.data.title}
                      width={120}
                      height={160}
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                    />
                  </div>
                </td>

                <td class="py-6 px-6">
                  <div class="font-bold font-serif text-base md:text-lg text-gray-900 dark:text-white leading-tight line-clamp-2 max-w-50 md:max-w-md">
                    {book.data.title}
                  </div>
                  <div class="md:hidden text-[10px] font-bold text-romance-600 dark:text-gold-500 mt-1 uppercase tracking-widest">
                    {book.data.category}
                  </div>
                </td>

                <td class="py-6 px-6 text-sm hidden md:table-cell italic text-gray-600 dark:text-gray-400">
                  {book.data.category}
                </td>

                <td class="py-6 px-6 text-sm hidden lg:table-cell text-center font-medium opacity-70">
                  {book.data.publishDate.toLocaleDateString("pl-PL")}
                </td>

                <td class="py-6 px-6 text-sm hidden xl:table-cell opacity-50 text-center font-mono">
                  {book.data.pages}
                </td>

                <td class="py-6 px-6 hidden sm:table-cell">
                  <span class="font-bold text-base text-romance-700 dark:text-gold-500 whitespace-nowrap">
                    {book.data.price ? `${book.data.price} zł` : "—"}
                  </span>
                </td>

                <td class="py-6 px-6 text-right">
                  <a
                    href={`/ksiazki/${book.slug}`}
                    class="link-elegant text-[10px] md:text-xs font-bold uppercase tracking-widest inline-flex items-center gap-2 group-hover:text-romance-600 dark:group-hover:text-gold-500 transition-all"
                  >
                    <span class="hidden md:inline">Szczegóły</span>
                    <span class="md:hidden bg-romance-600 text-white p-2 rounded-full">
                      →
                    </span>
                  </a>
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
</section>
