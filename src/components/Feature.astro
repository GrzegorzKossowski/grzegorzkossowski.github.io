---
interface Props {
  title: string;
  description: string;
  image?: string;
}
const { title, description, image = "/blog-placeholder-1.jpg" } = Astro.props;
---

<section
  class="text-gray-600 body-font bg-gray-50 dark:bg-slate-900/50 transition-colors duration-500"
  id="benefits"
>
  <div class="container px-5 py-24 mx-auto">
    <div class="flex flex-col text-center w-full mb-16">
      <h2
        class="text-xs text-romance-600 dark:text-gold-500 tracking-widest font-medium title-font mb-1 uppercase"
      >
        Zostańmy w kontakcie
      </h2>
      <h1
        class="sm:text-4xl text-3xl font-bold title-font mb-4 text-gray-900 dark:text-white font-serif"
      >
        Co zyskujesz w newsletterze?
      </h1>
      <p
        class="lg:w-2/3 mx-auto leading-relaxed text-base text-gray-500 dark:text-gray-400"
      >
        Nie wysyłam spamu. Tylko konkretne materiały dla fanów dobrych historii.
      </p>
    </div>

    <div class="flex flex-wrap -m-4">
      <div class="p-4 md:w-1/3 w-full">
        <div
          class="h-full p-8 rounded-2xl border border-gray-200 dark:border-slate-800 bg-white dark:bg-slate-950 shadow-sm hover:shadow-md transition-shadow"
        >
          <div
            class="w-10 h-10 inline-flex items-center justify-center rounded-full bg-romance-100 dark:bg-romance-900/30 text-romance-600 dark:text-romance-400 mb-5"
          >
            <svg
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="w-6 h-6"
              viewBox="0 0 24 24"
              ><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg
            >
          </div>
          <h2
            class="text-gray-900 dark:text-white text-lg title-font font-bold mb-3"
          >
            Bonusowe Rozdziały
          </h2>
          <p class="leading-relaxed text-base text-gray-500 dark:text-gray-400">
            Zupełnie darmowe sceny i alternatywne zakończenia Twoich ulubionych
            historii.
          </p>
        </div>
      </div>

      <div class="p-4 md:w-1/3 w-full">
        <div
          class="h-full p-8 rounded-2xl border-2 border-romance-500 dark:border-gold-500 bg-white dark:bg-slate-950 shadow-xl relative overflow-hidden"
        >
          <span
            class="bg-romance-600 dark:bg-gold-500 text-white px-3 py-1 tracking-widest text-[10px] absolute right-0 top-0 rounded-bl font-bold uppercase"
          >
            Najlepsze
          </span>

          <div
            class="w-10 h-10 inline-flex items-center justify-center rounded-full bg-romance-100 dark:bg-romance-900/30 text-romance-600 dark:text-romance-400 mb-5"
          >
            <svg
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="w-6 h-6"
              viewBox="0 0 24 24"
              ><path
                d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 11-7.6-10.6 8.38 8.38 0 013.8.9L21 3z"
              ></path></svg
            >
          </div>
          <h2
            class="text-gray-900 dark:text-white text-lg title-font font-bold mb-3"
          >
            Kulisy i Zapowiedzi
          </h2>
          <p class="leading-relaxed text-base text-gray-500 dark:text-gray-400">
            Subskrybenci jako pierwsi poznają tytuły, oglądają projekty okładek
            i śledzą postępy prac nad nowymi tomami.
          </p>
        </div>
      </div>

      <div class="p-4 md:w-1/3 w-full">
        <div
          class="h-full p-8 rounded-2xl border border-gray-200 dark:border-slate-800 bg-white dark:bg-slate-950 shadow-sm"
        >
          <div
            class="w-10 h-10 inline-flex items-center justify-center rounded-full bg-romance-100 dark:bg-romance-900/30 text-romance-600 dark:text-romance-400 mb-5"
          >
            <svg
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="w-6 h-6"
              viewBox="0 0 24 24"
              ><circle cx="12" cy="12" r="3"></circle><path
                d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z"
              ></path></svg
            >
          </div>
          <h2
            class="text-gray-900 dark:text-white text-lg title-font font-bold mb-3"
          >
            Wpływ na fabułę
          </h2>
          <p class="leading-relaxed text-base text-gray-500 dark:text-gray-400">
            Głosuj w ankietach na imiona bohaterów lub kierunki, w których
            podążą kolejne tomy.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
