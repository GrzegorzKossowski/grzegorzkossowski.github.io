---
import { Sun, Moon } from "lucide-astro";
---

<button
  id="themeToggle"
  aria-label="Zmień motyw"
  class="group relative inline-flex h-10 w-10 items-center justify-center rounded-full
         transition-all duration-500 hover:scale-110 active:scale-95
         bg-sky-100 text-sky-600 dark:bg-slate-800 dark:text-yellow-400"
>
  {/* Ikona Słońca: widoczna w Dark Mode */}
  <div
    class="sun-icon absolute transition-all duration-500 transform
              scale-0 rotate-90 dark:scale-100 dark:rotate-0"
  >
    <Sun size={20} />
  </div>

  {/* Ikona Księżyca: widoczna w Light Mode */}
  <div
    class="moon-icon absolute transition-all duration-500 transform
              scale-100 rotate-0 dark:scale-0 dark:rotate-90"
  >
    <Moon size={20} />
  </div>
</button>

<script>
  function applyTheme() {
    const localStorageTheme = localStorage.getItem("theme");
    const systemTheme = window.matchMedia("(prefers-color-scheme: dark)")
      .matches
      ? "dark"
      : "light";
    const theme = localStorageTheme || systemTheme;

    if (theme === "dark") {
      document.documentElement.classList.add("dark");
    } else {
      document.documentElement.classList.remove("dark");
    }
  }

  const setupThemeToggle = () => {
    const themeBtn = document.getElementById("themeToggle");

    if (themeBtn) {
      themeBtn.onclick = () => {
        const element = document.documentElement;
        element.classList.toggle("dark");

        const isDark = element.classList.contains("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      };
    }
  };

  // 1. Ustaw motyw przy starcie
  applyTheme();
  setupThemeToggle();

  // 2. Obsłuż powrót motywu po nawigacji Astro
  document.addEventListener("astro:after-swap", applyTheme);
  document.addEventListener("astro:page-load", setupThemeToggle);
</script>
