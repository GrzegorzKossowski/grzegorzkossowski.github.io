---
import { Sun, Moon } from 'lucide-astro';
---

<button 
  id="themeToggle" 
  aria-label="Zmień motyw"
  class="group relative inline-flex h-10 w-10 items-center justify-center rounded-full 
         transition-all duration-500 hover:scale-110 active:scale-95
         /* Kolory dla jasnego motywu */
         bg-sky-100 text-sky-600
         /* Kolory dla ciemnego motywu - sprawdzamy czy zadziała z wymuszeniem */
         dark:bg-slate-800 dark:text-yellow-400"
>
  <div class="sun-icon absolute transition-all duration-500 transform 
              scale-0 rotate-90 dark:scale-100 dark:rotate-0">
    <Sun size={20} />
  </div>
  
  <div class="moon-icon absolute transition-all duration-500 transform 
              scale-100 rotate-0 dark:scale-0 dark:rotate-90">
    <Moon size={20} />
  </div>
</button>

<script>
  const handleToggleClick = () => {
    const element = document.documentElement;
    element.classList.toggle("dark");
    const isDark = element.classList.contains("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  };

  document.getElementById("themeToggle")?.addEventListener("click", handleToggleClick);
</script>