---
import { Send } from "lucide-astro";
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Dołącz do czytelników",
  description = "Zapisz się, aby otrzymywać bonusowe rozdziały i informacje o premierach prosto na skrzynkę.",
} = Astro.props;
---

<section
  class="text-gray-600 body-font bg-white dark:bg-slate-950 transition-colors duration-500"
  id="newsletter"
>
  <div class="container px-5 py-24 mx-auto">
    <div class="flex flex-col text-center w-full mb-12">
      <h1
        class="sm:text-4xl text-3xl font-bold title-font mb-4 text-gray-900 dark:text-white font-serif"
      >
        {title}
      </h1>
      <p
        class="lg:w-2/3 mx-auto leading-relaxed text-base text-gray-500 dark:text-gray-400"
      >
        {description}
      </p>
    </div>

    <form
      class="flex lg:w-3/4 w-full sm:flex-row flex-col mx-auto px-8 sm:space-x-4 sm:space-y-0 space-y-4 sm:px-0 items-end justify-center"
    >
      <div class="relative grow w-full max-w-sm">
        <label
          for="full-name"
          class="leading-7 text-sm text-gray-600 dark:text-gray-400 font-medium"
          >Imię</label
        >
        <input
          type="text"
          id="full-name"
          name="fields[name]"
          placeholder="Twoje imię..."
          class="w-full bg-gray-100 dark:bg-slate-900 bg-opacity-50 rounded-lg border border-gray-300 dark:border-slate-800 focus:border-romance-500 focus:bg-transparent focus:ring-2 focus:ring-romance-200 dark:focus:ring-romance-900/30 text-base outline-none text-gray-700 dark:text-white py-1 px-3 leading-8 transition-colors duration-200 ease-in-out"
        />
      </div>
      <div class="relative grow w-full max-w-sm">
        <label
          for="email"
          class="leading-7 text-sm text-gray-600 dark:text-gray-400 font-medium"
          >Email</label
        >
        <input
          type="email"
          id="email"
          name="email"
          placeholder="twoj@email.pl"
          required
          class="w-full bg-gray-100 dark:bg-slate-900 bg-opacity-50 rounded-lg border border-gray-300 dark:border-slate-800 focus:border-romance-500 focus:bg-transparent focus:ring-2 focus:ring-romance-200 dark:focus:ring-romance-900/30 text-base outline-none text-gray-700 dark:text-white py-1 px-3 leading-8 transition-colors duration-200 ease-in-out"
        />
      </div>
      <button
        id="submit-btn"
        disabled
        class="text-white bg-romance-600 border-0 py-2 px-8 focus:outline-none hover:bg-romance-500 rounded-lg text-lg font-bold flex items-center shadow-lg shadow-romance-600/20 transition-all active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed disabled:grayscale"
      >
        <Send size={18} class="mr-2" />
        Zapisuję się
      </button>
    </form>

    <div class="lg:w-3/4 w-full mx-auto mt-6 px-8 sm:px-0 text-left">
      <label class="flex items-start cursor-pointer group">
        <input
          type="checkbox"
          id="privacy-checkbox"
          class="mt-1 rounded border-gray-300 dark:border-slate-800 text-romance-600 focus:ring-romance-500"
        />
        <span
          class="ml-3 text-xs text-gray-500 dark:text-gray-400 leading-relaxed"
        >
          Akceptuję <a
            href="/polityka"
            class="underline hover:text-romance-600 transition-colors"
            >politykę prywatności</a
          >. Wyrażam zgodę na otrzymywanie informacji o nowościach i premierach.
        </span>
      </label>
    </div>
  </div>
</section>

<script>
  // Używamy document.addEventListener, aby skrypt działał poprawnie z View Transitions w Astro
  document.addEventListener("astro:page-load", () => {
    const checkbox = document.getElementById(
      "privacy-checkbox",
    ) as HTMLInputElement;
    const submitBtn = document.getElementById(
      "submit-btn",
    ) as HTMLButtonElement;

    if (checkbox && submitBtn) {
      checkbox.addEventListener("change", () => {
        submitBtn.disabled = !checkbox.checked;
      });
    }
  });
</script>
