---
import { Send, Loader2 } from "lucide-astro";
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Dołącz do innych czytelniczek i czytelników!",
  description = "Zapisz się, aby otrzymywać bonusowe rozdziały i informacje o premierach prosto na skrzynkę.",
} = Astro.props;

// Te dane znajdziesz w kodzie formularza "Embedded" w MailerLite
const MAILERLITE_ACCOUNT_ID = "2166164"; 
const MAILERLITE_FORM_ID = "181173245884499002";
---


<section
class="text-gray-600 body-font bg-white dark:bg-slate-950 transition-colors duration-500"
id="newsletter"
>
<div class="container px-5 py-24 mx-auto">
  <div class="flex flex-col text-center w-full mb-12">
    <h1 class="sm:text-4xl text-3xl font-bold title-font mb-4 text-gray-900 dark:text-white font-serif">
      {title}
    </h1>
    <p class="lg:w-2/3 mx-auto leading-relaxed text-base text-gray-500 dark:text-gray-400">
      {description}
    </p>
  </div>
    <form
      id="mailerlite-form"
      action={`https://assets.mailerlite.com/jsonp/${MAILERLITE_ACCOUNT_ID}/forms/${MAILERLITE_FORM_ID}/subscribe`}
      method="POST"
      class="flex flex-wrap lg:w-3/4 w-full mx-auto px-4 sm:px-0 gap-4 items-end justify-center"
      data-code=""
      
    >
      <div class="flex-1 min-w-70 w-full">
        <label for="full-name" class="leading-7 text-sm text-gray-600 dark:text-gray-400 font-medium">Imię</label>
        <input
          type="text"
          id="full-name"
          name="fields[name]" 
          placeholder="Twoje imię..."
          class="w-full bg-gray-100 dark:bg-slate-900 bg-opacity-50 rounded-lg border border-gray-300 dark:border-slate-800 focus:border-romance-500 focus:bg-transparent focus:ring-2 focus:ring-romance-200 dark:focus:ring-romance-900/30 text-base outline-none text-gray-700 dark:text-white py-1.5 px-3 leading-8 transition-colors duration-200 ease-in-out"
        />
      </div>

      <div class="flex-1 min-w-70 w-full">
        <label for="email" class="leading-7 text-sm text-gray-600 dark:text-gray-400 font-medium">Email *</label>
        <input
          type="email"
          id="email"
          name="fields[email]" 
          placeholder="twoj@email.pl"
          required
          class="w-full bg-gray-100 dark:bg-slate-900 bg-opacity-50 rounded-lg border border-gray-300 dark:border-slate-800 focus:border-romance-500 focus:bg-transparent focus:ring-2 focus:ring-romance-200 dark:focus:ring-romance-900/30 text-base outline-none text-gray-700 dark:text-white py-1.5 px-3 leading-8 transition-colors duration-200 ease-in-out"
        />
      </div>

      <button
        type="submit"
        id="submit-btn"
        disabled
        class="w-full md:w-auto whitespace-nowrap text-white bg-romance-600 border-0 py-2.5 px-8 focus:outline-none hover:bg-romance-500 rounded-lg text-lg font-bold flex items-center justify-center shadow-lg shadow-romance-600/20 transition-all active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed disabled:grayscale min-w-45"
      >
        <Send id="icon-send" size={18} class="mr-2 shrink-0" />
        <Loader2 id="icon-loader" size={18} class="mr-2 shrink-0 animate-spin hidden" />
        <span id="btn-text">Zapisuję się</span>
      </button>
    </form>

    <div id="form-feedback" class="lg:w-3/4 w-full mx-auto mt-4 px-4 sm:px-0 hidden">
        <p class="text-green-600 dark:text-green-400 font-bold">Dziękuję! Sprawdź skrzynkę, aby potwierdzić zapis.</p>
    </div>

    <div class="lg:w-3/4 w-full mx-auto mt-6 px-4 sm:px-0 text-left">
      <label class="flex items-start cursor-pointer group">
        <input
          type="checkbox"
          id="privacy-checkbox"
          class="mt-1 rounded border-gray-300 dark:border-slate-800 text-romance-600 focus:ring-romance-500"
        />
        <span class="ml-3 text-xs text-gray-500 dark:text-gray-400 leading-relaxed">
          Akceptuję <a href="/polityka" class="underline hover:text-romance-600 transition-colors">politykę prywatności</a>. Wyrażam zgodę na otrzymywanie informacji o nowościach i premierach.
        </span>
      </label>
    </div>
  </div>
</section>

<script>
  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("mailerlite-form") as HTMLFormElement;
    const checkbox = document.getElementById("privacy-checkbox") as HTMLInputElement;
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
    const btnText = document.getElementById("btn-text");
    const iconSend = document.getElementById("icon-send");
    const iconLoader = document.getElementById("icon-loader");
    const feedback = document.getElementById("form-feedback");

    if (checkbox && submitBtn) {
      checkbox.addEventListener("change", () => {
        submitBtn.disabled = !checkbox.checked;
      });
    }

    if (form) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        
        // UI Loading state
        submitBtn.disabled = true;
        btnText!.textContent = "Wysyłanie...";
        iconSend!.classList.add("hidden");
        iconLoader!.classList.remove("hidden");

        const formData = new FormData(form);

        try {
          // MailerLite JSONP endpoint obsługuje zwykły POST w fetch
          const response = await fetch(form.action, {
            method: "POST",
            body: formData,
          });

          if (response.ok) {
            form.classList.add("hidden");
            feedback!.classList.remove("hidden");
          } else {
            throw new Error("Błąd serwera");
          }
        } catch (error) {
          alert("Wystąpił błąd. Spróbuj ponownie później.");
          submitBtn.disabled = false;
          btnText!.textContent = "Zapisuję się";
          iconSend!.classList.remove("hidden");
          iconLoader!.classList.add("hidden");
        }
      });
    }
  });
</script>