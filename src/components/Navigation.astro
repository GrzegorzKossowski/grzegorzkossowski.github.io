---
import ThemeIcon from "../components/ThemeIcon.astro";
import { Book, BookOpen } from "lucide-astro";
import { slugify } from "../utils/slugify";
interface Props {
  firstName?: string;
  lastName?: string;
  showNewsletter?: boolean;
}
const { firstName, lastName, showNewsletter } = Astro.props;
const navLinks = [
  { href: "/nowosci", label: "Nowości" },
  { href: "/ksiazki", label: "Książki" },
  { href: "/serie", label: "Serie" },
  { href: "/o-mnie", label: "O mnie" },
];
---

<header
  class="body-font border-b border-gray-100 dark:border-slate-800 transition-colors duration-500 sticky top-0 z-50 bg-white/90 dark:bg-slate-950/90 backdrop-blur-sm"
>
  <div class="container mx-auto flex p-5 items-center justify-between">
    <a
      href="/"
      class="flex title-font font-medium items-center group cursor-pointer"
    >
      <div
        class="p-2 bg-romance-600 rounded-lg text-white group-hover:bg-romance-500 transition-colors shadow-lg shadow-romance-600/20"
      >
        <Book size={28} strokeWidth={2.5} />
      </div>
      <span
        class="ml-3 text-2xl font-bold tracking-tight text-gray-900 dark:text-white font-serif"
      >
        {firstName}
        <span class="text-romance-600 dark:text-gold-500">{lastName}</span>
      </span>
    </a>

    <div class="flex items-center">
      <nav
        class="hidden md:flex flex-wrap items-center text-base font-medium mr-6"
      >
        {
          navLinks.map((link) => (
            <a href={link.href} class="mr-6 link-elegant">
              {link.label}
            </a>
          ))
        }
      </nav>
      
      {
        showNewsletter && (
          <a
            href="#newsletter"
            class="hidden lg:inline-flex items-center justify-center btn-primary py-2! px-5! text-sm mr-6"
          >
            <BookOpen class="mr-2" size={16} />
            Dla Ciebie
          </a>
        )
      }

      <div class="pl-6">
        <ThemeIcon />
      </div>
    </div>
  </div>

  <div
    class="md:hidden border-t border-gray-50 dark:border-slate-800/50 bg-gray-50/30 dark:bg-slate-900/20"
  >
    <nav
      class="flex flex-wrap justify-center gap-x-6 gap-y-2 p-4 text-base font-medium"
    >
      {
        navLinks.map((link) => (
          <a href={link.href} class="mr-6 link-elegant">
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
