---
import { ChevronUp } from "lucide-astro";
---

<button
  id="scrollToTop"
  aria-label="Wróć do góry"
  class="fixed bottom-8 right-8 z-999 flex h-12 w-12 translate-y-20 items-center justify-center rounded-full bg-romance-600 text-white shadow-xl transition-all duration-500 opacity-0 hover:bg-romance-500 hover:scale-110 active:scale-95 dark:bg-gold-500 dark:text-gray-900"
>
  <ChevronUp size={28} strokeWidth={2.5} />
</button>

<script>
  const initScroll = () => {
    const scrollBtn = document.getElementById("scrollToTop");
    if (!scrollBtn) return;

    const handleScroll = () => {
      const y = window.scrollY || document.documentElement.scrollTop;
      if (y > 300) {
        scrollBtn.classList.remove(
          "translate-y-20",
          "opacity-0",
          "pointer-events-none",
        );
        scrollBtn.classList.add(
          "translate-y-0",
          "opacity-100",
          "pointer-events-auto",
        );
      } else {
        scrollBtn.classList.add(
          "translate-y-20",
          "opacity-0",
          "pointer-events-none",
        );
        scrollBtn.classList.remove(
          "translate-y-0",
          "opacity-100",
          "pointer-events-auto",
        );
      }
    };

    window.addEventListener("scroll", handleScroll);
    scrollBtn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  };

  // To uruchamia skrypt przy każdym przejściu strony
  document.addEventListener("astro:page-load", initScroll);
</script>

<style>
  /* Zapewniamy, że przycisk nie przeszkadza w interakcji, gdy jest ukryty */
  #scrollToTop.opacity-0 {
    pointer-events: none;
  }
</style>
