---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";

// 1. Używamy eager: true, aby od razu dostać dane obrazów
// 2. Object.values zamienia obiekt na tablicę, po której można robić .map()
const imagesGlob = import.meta.glob("../../assets/humor/*.{jpeg,jpg,png,gif}", {
  eager: true,
});
const images = Object.values(imagesGlob) as any[];
---

<Layout title="O mnie">
  <section class="container mx-auto px-5 py-24">
    <h1 class="text-h1">
      Grafika <span class="text-romance-600">satyryczna</span>
    </h1>
    <h2>Ponad 200 rysunków satyrycznych gotowych do publikacji!</h2>
    <p>
      Szukasz błyskotliwego komentarza wizualnego do swojego wydawnictwa,
      portalu lub czasopisma? Zapraszam do współpracy!
    </p>
    <p>
      Oferuję dostęp do bogatego archiwum ponad 200 autorskich rysunków
      satyrycznych o zróżnicowanej tematyce – od spraw społecznych i
      obyczajowych, po uniwersalny humor codzienny.
    </p>
    <p>Zasady współpracy:</p>
    <p>
      Współpracuję w oparciu o licencję niewyłączną na konkretnych polach
      eksploatacji (np. druk lub publikacja cyfrowa). Co to oznacza dla Państwa?
    </p>
    <ul>
      <li>Możliwość dostosowania grafik do indywidualnych potrzeb (rozmiary x y)</li>
      <li>Szybki dostęp do gotowych, wysokiej jakości materiałów</li>
      <li>
        Przejrzyste koszty – płacisz za prawo do publikacji, nie przejmując
        całości autorskich praw majątkowych
      </li>
      <li>
        Elastyczność – możliwość jednorazowego zakupu większej ilości lub stałej współpracy, np. miesięcznej subskrypcji na nowe rysunki
      </li>
    </ul>
    <p>
      Moje rysunki to sprawdzony sposób na przyciągnięcie oka czytelnika i
      nadanie publikacji unikalnego charakteru.
    </p>
    <p>
      <a href="/kontakt" class="link-elegant text-gold-500">Zapraszam do kontaktu</a
      > w celu obejrzenia portfolio i ustalenia szczegółów!
    </p>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 p-4">
      {
        images.map((img) => (
          <button
            class="gallery-item group relative aspect-square w-full overflow-hidden rounded-lg bg-gray-100 transition-all duration-300 hover:shadow-xl active:scale-95"
            data-full-src={img.default.src}
          >
            <Image
              src={img.default}
              alt="huorystyczny obrazek"
              width={600}
              height={600}
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-110 pointer-events-none"
            />
          </button>
        ))
      }
    </div>

<dialog
  id="gallery-modal"
  class="fixed inset-0 m-0 h-full w-full max-h-none max-w-none bg-transparent p-0 backdrop:bg-black/90 focus:outline-none overflow-hidden border-none"
>
  <div class="relative flex h-dvh w-screen items-center justify-center p-2 md:p-8">
    
    <img
      id="modal-img"
      src=""
      alt=""
      class="max-h-full max-w-full object-contain shadow-2xl transition-all duration-300"
    />

    <button
      id="close-modal"
      class="absolute top-4 right-4 z-50 flex h-12 w-12 items-center justify-center rounded-full bg-black/20 text-white text-4xl font-light backdrop-blur-sm hover:bg-black/40 transition"
      aria-label="Zamknij"
    >
      &times;
    </button>
  </div>
</dialog>
  </section>
</Layout>

<script>
  // TypeScript lubi dokładność przy pobieraniu elementów
  const dialog = document.getElementById("gallery-modal") as HTMLDialogElement;
  const modalImg = document.getElementById("modal-img") as HTMLImageElement;
  const buttons = document.querySelectorAll(".gallery-item");
  const closeBtn = document.getElementById("close-modal");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const fullSrc = button.getAttribute("data-full-src");
      if (fullSrc && modalImg) {
        modalImg.src = fullSrc;
        dialog.showModal();
        // Zapobiegamy scrollowaniu tła
        document.body.style.overflow = "hidden";
      }
    });
  });

  const closeModal = () => {
    dialog.close();
    document.body.style.overflow = "auto";
  };

  closeBtn?.addEventListener("click", closeModal);

  // Zamykanie po kliknięciu w tło (backdrop)
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog) closeModal();
  });

  // Obsługa klawisza ESC
  dialog.addEventListener("cancel", () => {
    document.body.style.overflow = "auto";
  });
</script>
