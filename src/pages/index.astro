---
// Welcome to Astro! Everything between these triple-dash code fences
// is your "component frontmatter". It never runs in the browser.
console.log("This runs in your terminal, not the browser!");
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Content from "../components/Content.astro";
import Ecommerce from "../components/Ecommerce.astro";
import Pricing from "../components/Pricing.astro";
import Testimonials from "../components/Testimonials.astro";
import NewsLetter from "../components/Newsletter.astro";
import { ShoppingBag, BookOpen } from "lucide-astro";
import LatestBooks from "../components/LatestBooks.astro";
---

<Layout title="Home Page">
  <Hero>
    <Fragment slot="author"> Romans, Romantasy & Isekai </Fragment>

    <Fragment slot="title">
      Zatrać się w światach, których
      <br class="hidden lg:inline-block" /> nie zechcesz już opuścić
    </Fragment>

    <Fragment slot="description">
      Od gorących romansów po epickie przygody. Odkryj historie, w których
      namiętność spotyka przeznaczenie. Twoja następna ulubiona podróż zaczyna
      się właśnie tutaj.
    </Fragment>

    <Fragment slot="buttons">
      <a href="https://www.empik.com/..." class="btn-primary">
        <ShoppingBag class="mr-2" size={22} /> Książki w Empik
      </a>
      <a href="#newsletter" class="btn-secondary">
        <BookOpen class="mr-2" size={22} /> Darmowy rozdział
      </a>
    </Fragment>

    <img
      slot="image"
      src="/images/latest-book-mockup.jpg"
      alt="Najnowsza książka"
      class="relative rounded-xl shadow-2xl transition duration-500 hover:scale-[1.01]"
    />
  </Hero>
  <LatestBooks />
  <!-- <Pricing
    title="Pricing Title"
    description="This is a description of the pricing section."
  />
  <Testimonials
    title="Testimonials Title"
    description="This is a description of the testimonials section."
  />
  <NewsLetter
    title="Newsletter Title"
    description="This is a description of the newsletter section."
  /> -->
</Layout>
