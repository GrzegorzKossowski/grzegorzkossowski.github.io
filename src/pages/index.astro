---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Feature from "../components/Feature.astro";
import Testimonials from "../components/Testimonials.astro";
import NewsLetter from "../components/Newsletter.astro";
import { ShoppingBag, BookOpen } from "lucide-astro";
import LatestBooks from "../components/LatestBooks.astro";
// console.log("This runs in your terminal, not the browser!");
---

<Layout title="Grzegorz Kossowski - strona autorska">
  <Hero>
    <Fragment slot="author"> Romans, Romantasy & Isekai </Fragment>

    <Fragment slot="title">
      Zatrać się w światach, których
      <br class="hidden lg:inline-block" /> nie zechcesz już opuścić
    </Fragment>

    <Fragment slot="description">
      Od gorących romansów po epickie przygody. Odkryj historie, w których
      namiętność spotyka przeznaczenie. Twoja następna ulubiona podróż zaczyna
      się właśnie tutaj.
    </Fragment>

    <Fragment slot="buttons">
      <a
        href="https://www.empik.com/szukaj/produkt?q=kossowski%20grzegorz&qtype=basicForm&ac=true&sort=publishDesc"
        class="btn-primary"
      >
        <ShoppingBag class="mr-2" size={22} /> Książki w Empik
      </a>
      <a href="#newsletter" class="btn-secondary">
        <BookOpen class="mr-2" size={22} /> Darmowy rozdział
      </a>
    </Fragment>

    <div slot="image" class="relative group overflow-hidden rounded-xl">
      <!-- Obrazek -->
      <img
        src="/images/latest-book-mockup-5.jpg"
        alt="Najnowsza książka"
        class="w-full rounded-xl shadow-2xl transition duration-500 group-hover:scale-[1.01]"
      />

      <!-- Winieta (Gradient od dołu) -->
      <div
        class="absolute inset-0 bg-linear-to-t from-black via-black/40 to-transparent h-full"
      >
      </div>

      <!-- Nakładka tekstowa -->
      <h2
        class="absolute bottom-5 right-5 text-gold-500 uppercase italic text-shadow-md text-shadow-black text-right z-10"
      >
        Wkrótce
        <br class="hidden lg:inline-block" />audiobook
      </h2>
    </div>
  </Hero>
  <LatestBooks />
  <Feature
    title="Feature Title"
    description="This is a description of the feature section."
  />
  <Testimonials title="Wasze wrażenia" />
</Layout>
