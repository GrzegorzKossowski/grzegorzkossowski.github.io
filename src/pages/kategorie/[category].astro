---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { slugify } from "../../utils/slugify";
import { initialCap } from "../../utils/initialCap";

export async function getStaticPaths() {
  const allBooks = await getCollection("books");

  // Wyciągamy unikalne kategorie z Twoich plików Markdown
  const uniqueCategories = [
    ...new Set(allBooks.map((book) => book.data.category || "inne")),
  ];

  return uniqueCategories.map((cat) => ({
    params: { category: slugify(cat) }, // slug w URL
    props: {
      categoryName: cat, // Oryginalna nazwa (np. "Romantasy")
      books: allBooks.filter((book) => book.data.category === cat),
    },
  }));
}

const { books, categoryName } = Astro.props;
---

<Layout title={`Kategoria: ${categoryName}`}>
  <section class="container mx-auto py-12 px-4">
    <h1 class="text-h1 mb-12">
      Książki z kategorii: <span class="text-romance-600"
        >{initialCap(categoryName)}</span>
    </h1>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        books.map((book) => (
          // Tutaj możesz użyć swojego komponentu karty książki
          <div class="border p-4 rounded-xl">
            <h2 class="text-xl font-bold">{book.data.title}</h2>
            <a href={`/ksiazki/${book.slug}`} class="btn-primary mt-4">
              Zobacz szczegóły
            </a>
          </div>
        ))
      }
    </div>
  </section>
</Layout>
