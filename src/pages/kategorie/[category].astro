---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { slugify } from "../../utils/slugify";
import { initialCap } from "../../utils/initialCap";
import { Image } from "astro:assets";
import placeholderCover from "../../assets/covers/placeholder-cover.jpg";

export async function getStaticPaths() {
  const allBooks = await getCollection("books");

  const uniqueCategories = [
    ...new Set(allBooks.map((book) => book.data.category || "inne")),
  ];

  return uniqueCategories.map((cat) => ({
    params: { category: slugify(cat) },
    props: {
      categoryName: cat,
      books: allBooks.filter((book) => book.data.category === cat),
    },
  }));
}

const { books, categoryName } = Astro.props;

// // Logika sortowania: Seria (alfabetycznie) -> Tom (rosnąco) -> Tytuł (alfabetycznie)
// const sortedBooks = books.sort((a, b) => {
//   if (a.data.series && b.data.series) {
//     if (a.data.series !== b.data.series) {
//       return a.data.series.localeCompare(b.data.series);
//     }
//     return (a.data.seriesOrder || 0) - (b.data.seriesOrder || 0);
//   }
//   if (a.data.series) return -1;
//   if (b.data.series) return 1;
//   return a.data.title.localeCompare(b.data.title);
// });

// Logika sortowania: Najpierw data (najnowsze), potem ewentualnie tytuł
const sortedBooks = books.sort((a, b) => {
  // 1. Sortowanie po dacie (od najnowszej)
  const dateA = new Date(a.data.publishDate).valueOf();
  const dateB = new Date(b.data.publishDate).valueOf();

  if (dateA !== dateB) {
    return dateB - dateA; // Najnowsze daty mają wyższy valueOf
  }

  // 2. Jeśli daty są identyczne, sortuj alfabetycznie po tytule
  return a.data.title.localeCompare(b.data.title);
});
---

<Layout title={`Kategoria: ${categoryName}`}>
  <section class="container mx-auto py-12 px-4">
    <h1 class="text-4xl md:text-5xl font-serif mb-12">
      Książki z kategorii: <span class="text-romance-600 dark:text-gold-500"
        >{initialCap(categoryName)}</span
      >
    </h1>

    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
      {
        sortedBooks.map((book) => {
          const coverImage = (book.data.cover || placeholderCover) as any;

          return (
            <a href={`/ksiazki/${book.slug}`} class="group block h-full">
              <div class="flex h-full bg-white dark:bg-slate-900/50 border border-gray-100 dark:border-slate-800 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl hover:bg-gray-50 dark:hover:bg-slate-800/80 transition-all p-3 cursor-pointer">
                {/* Lewa kolumna: Okładka */}
                <div class="w-1/3 max-w-30 shrink-0">
                  <div class="aspect-2/3 overflow-hidden rounded-xl shadow-sm bg-gray-100 dark:bg-slate-800">
                    <Image
                      src={coverImage}
                      alt={book.data.title}
                      width={240}
                      height={360}
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                    />
                  </div>
                </div>

                {/* Prawa kolumna: Informacje */}
                <div class="flex flex-col justify-between pl-5 py-2 w-full">
                  <div>
                    {book.data.series && (
                      <div class="text-[10px] font-bold uppercase tracking-widest text-romance-600 dark:text-gold-500 mb-1">
                        {book.data.series}{" "}
                        {book.data.seriesOrder && `(T${book.data.seriesOrder})`}
                      </div>
                    )}
                    <h2 class="text-lg md:text-xl font-bold font-serif text-gray-900 dark:text-white leading-tight group-hover:text-romance-600 dark:group-hover:text-gold-500 transition-colors line-clamp-2">
                      {book.data.title}
                    </h2>

                    {book.data.price && (
                      <p class="text-sm font-medium text-gray-500 dark:text-gray-400 mt-2">
                        {book.data.price} zł
                      </p>
                    )}
                  </div>

                  <div class="mt-4 flex items-center text-sm font-bold uppercase tracking-widest text-gray-400 group-hover:text-romance-600 dark:group-hover:text-gold-500 transition-all">
                    Szczegóły{" "}
                    <span class="ml-2 transition-transform group-hover:translate-x-1">
                      →
                    </span>
                  </div>
                </div>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>
</Layout>
