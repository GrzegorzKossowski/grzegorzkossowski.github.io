---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const allBooks = await getCollection('books');
  const categories = [...new Set(allBooks.map(b => b.data.category))];
  return categories.map(cat => ({
    params: { category: cat },
    props: { books: allBooks.filter(b => b.data.category === cat) }
  }));
}
const { category } = Astro.params;
const { books } = Astro.props;
---
<Layout title={`Gatunek: ${category}`}>
  <section class="py-24 container mx-auto px-5">
    <h1 class="text-h1 mb-12 capitalize">{category}</h1>
    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-8">
      {books.map(book => (
        <a href={`/ksiazki/${book.slug}`} class="group">
          <div class="overflow-hidden rounded-xl aspect-5/7 mb-4 shadow-lg"><img src={book.data.cover.src} class="group-hover:scale-105 transition-transform duration-500" /></div>
          <h3 class="font-serif font-bold text-lg">{book.data.title}</h3>
        </a>
      ))}
    </div>
  </section>
</Layout>