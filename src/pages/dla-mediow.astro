      Press <span class="text-romance-600 dark:text-gold-500">Kit</span>
    </h1>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mt-12">
      <div class="md:col-span-1">
        <div class="sticky top-24">
