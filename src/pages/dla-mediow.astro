              <span class="text-slate-400 font-serif italic text-sm text-center px-4">Zdjęcie prasowe autora</span>
            </div>
          </div> -->
          
          <!-- <div class="space-y-4">
            <a href="#" class="flex items-center justify-center gap-2 bg-romance-600 hover:bg-romance-700 text-white py-3 px-4 rounded-xl font-bold text-sm transition-all w-full">
